{
  "providers": [
    {
      "name": "modelscope-235b",
      "group": "modelscope",
      "base_url": "https://api-inference.modelscope.cn/v1",
      "model": [
        "Qwen/Qwen3-VL-235B-A22B-Instruct"
      ],
      "api_key": "在此填入魔搭 ModelScope token",
      "input_mode": "base64",
      "timeout": 120,
      "enabled": true,
      "multi": true
    },
    {
      "name": "internai",
      "group": "internai",
      "base_url": "https://chat.intern-ai.org.cn/api/v1",
      "model": [
        "internvl3.5-latest"
      ],
      "api_key": "在此填入 InternAI(上海AI实验室) token；免费领取 https://internlm.intern-ai.org.cn/api/tokens",
      "input_mode": "base64",
      "timeout": 120,
      "enabled": false,
      "multi": true
    },
    {
      "name": "glm",
      "group": "glm",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "model": "glm-4.6v-flash",
      "api_key": "在此填入智谱API Key；也可用 scripts/encrypt_key.py 生成 dpapi: 加密串",
      "input_mode": "base64",
      "timeout": 60,
      "enabled": true,
      "multi": true
    },
    {
      "name": "glm-thinking",
      "group": "glm",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "model": "glm-4.1v-thinking-flash",
      "api_key": "复用智谱API Key",
      "input_mode": "base64",
      "timeout": 90,
      "enabled": true,
      "multi": true
    },
    {
      "name": "modelscope-8b-thinking",
      "group": "modelscope",
      "base_url": "https://api-inference.modelscope.cn/v1",
      "model": [
        "Qwen/Qwen3-VL-8B-Thinking"
      ],
      "api_key": "复用魔搭 ModelScope token",
      "input_mode": "base64",
      "timeout": 90,
      "enabled": true,
      "multi": true
    },
    {
      "name": "modelscope-8b",
      "group": "modelscope",
      "base_url": "https://api-inference.modelscope.cn/v1",
      "model": [
        "Qwen/Qwen3-VL-8B-Instruct"
      ],
      "api_key": "复用魔搭 ModelScope token",
      "input_mode": "base64",
      "timeout": 90,
      "enabled": true,
      "multi": true
    },
    {
      "name": "glm4v",
      "group": "glm",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "model": "glm-4v-flash",
      "api_key": "复用智谱API Key",
      "input_mode": "base64",
      "timeout": 60,
      "enabled": true,
      "multi": true
    },
    {
      "name": "agnes",
      "group": "agnes",
      "base_url": "https://api.agnes-ai.cn/v1",
      "model": "agnes-2.5-flash",
      "api_key": "在此填入Agnes API Key",
      "input_mode": "base64",
      "timeout": 60,
      "enabled": true,
      "multi": true
    }
  ],
  "routing": {
    "default_chain": [
      "modelscope-235b",
      "internai",
      "glm",
      "glm-thinking",
      "modelscope-8b-thinking",
      "modelscope-8b",
      "glm4v",
      "agnes"
    ],
    "overrides": {
      "math_stem": [
        "glm-thinking",
        "glm",
        "modelscope-235b",
        "internai",
        "modelscope-8b-thinking",
        "modelscope-8b",
        "glm4v",
        "agnes"
      ],
      "chart": [
        "glm-thinking",
        "glm",
        "modelscope-235b",
        "internai",
        "modelscope-8b-thinking",
        "modelscope-8b",
        "glm4v",
        "agnes"
      ]
    },
    "multi_tasks": [
      "error",
      "math_stem",
      "detail",
      "compare"
    ],
    "max_multi_groups": 3
  },
  "task_check": true,
  "summarizer": "agnes",
  "quota": {
    "enabled": true,
    "reserve_ratio": 0.2,
    "min_interval_sec": 5,
    "state_file": "",
    "cooldown_default_sec": 60,
    "cooldown_max_sec": 300
  },
  "max_size": "auto",
  "jpeg_quality": 88,
  "auto_trim": false,
  "temperature": 0.2,
  "max_tokens": 2048,
  "timeout": 60,
  "retries": 1,
  "retry_delay": 2,
  "image_max_bytes": 8000000,
  "image_max_pixels": 40000000,
  "download_timeout": 20,
  "allow_local_url": false,
  "web": {
    "max_page_bytes": 2000000,
    "max_images": 6
  },
  "cache": {
    "enabled": true,
    "ttl_seconds": 3600,
    "max_entries": 200,
    "dir": ""
  },
  "security_note": true,
  "groups": {
    "modelscope": {
      "multi": true,
      "min_interval_sec": 5.0,
      "monthly_token_limit": 0,
      "daily_group_limit": 2000,
      "daily_model_limit": 500
    },
    "glm": {
      "multi": true,
      "min_interval_sec": 0.0,
      "monthly_token_limit": 0,
      "daily_group_limit": 0,
      "daily_model_limit": 0
    },
    "agnes": {
      "multi": true,
      "min_interval_sec": 0.0,
      "monthly_token_limit": 0,
      "daily_group_limit": 0,
      "daily_model_limit": 0
    },
    "internai": {
      "multi": true,
      "min_interval_sec": 2.0,
      "monthly_token_limit": 90000000,
      "daily_group_limit": 0,
      "daily_model_limit": 0
    }
  },
  "tasks": {
    "general": {
      "max_size": 1568,
      "focus": "请描述这张图片的内容"
    },
    "ocr": {
      "max_size": 2048,
      "focus": "请逐字提取图中所有文字"
    },
    "error": {
      "max_size": 2048,
      "focus": "请定位图中的报错/异常信息"
    },
    "ui": {
      "max_size": 1568,
      "focus": "请分析界面布局与 UI 问题"
    },
    "chart": {
      "max_size": 1568,
      "focus": "请解读图表数据"
    },
    "compare": {
      "max_size": 1568,
      "focus": "请对比这些图片并指出异同"
    },
    "document": {
      "max_size": 2048,
      "focus": "请提取文档的结构化内容"
    },
    "math_stem": {
      "max_size": 1568,
      "focus": "请解答图中的题目并给出步骤"
    },
    "detail": {
      "max_size": 2048,
      "focus": "请观察并描述图中的细节"
    },
    "video": {
      "max_size": 1568,
      "focus": "请描述视频帧/截图的内容"
    },
    "unknown": {
      "max_size": 1568,
      "focus": "请描述这张图片的内容"
    }
  },
  "doctor": {
    "timeout_sec": 15,
    "max_concurrent": 4
  },
  "max_redirects": 5
}
